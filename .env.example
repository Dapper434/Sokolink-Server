# Copy this file to .env and fill in real values. Never commit .env.

# Flask / JWT
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# Database (SQLite is the local default)
DATABASE_URL=sqlite:///sokolink.db

# Safaricom Daraja (sandbox or production values from the Daraja portal)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-host.example/api/orders/mpesa-callback
